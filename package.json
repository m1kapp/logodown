{
  "name": "@m1kapp/logodown",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "logodown": "dist-cli/logodown.mjs"
  },
  "files": [
    "dist-cli"
  ],
  "scripts": {
    "stats": "m1kkit stats --dir=src --out=public",
    "dev": "m1kkit stats --dir=src --out=public || true && vite",
    "build": "m1kkit stats --dir=src --out=public || true && vite build",
    "bbox": "vite build --config vite.bbox.config.ts && node dist-bbox/gen-symbol-bbox.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "prepare": "npm run build:cli",
    "preview": "vite preview"
  },
  "dependencies": {
    "@m1kapp/kit": "^0.0.39",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.2",
    "opentype.js": "^1.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
